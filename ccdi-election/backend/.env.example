# ---- Supabase ----
# Project Settings → API in your Supabase dashboard.
# Use the SERVICE ROLE key here (not the anon/public key) — the backend
# needs it to bypass Row Level Security, since RLS is locked down with no
# public policies. Never expose the service role key to the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
# Any long random string. Used to sign student/admin session tokens.
JWT_SECRET=change-this-to-a-long-random-string

# ---- Outgoing email (for credential + OTP emails) ----
# Works with Gmail SMTP using an App Password (Google Account → Security
# → 2-Step Verification → App passwords), or any SMTP provider such as
# Resend, SendGrid, or Mailgun's SMTP relay.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="CCDI Election Portal <your-sending-address@gmail.com>"

# ---- CORS ----
# The deployed URL of the frontend (Netlify, Vercel, GitHub Pages, etc.),
# no trailing slash. Use * only while testing locally.
FRONTEND_ORIGIN=http://localhost:5500

# ---- Server ----
PORT=4000
